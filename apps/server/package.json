{
  "name": "@beans-web/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.{test,spec}.ts'",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --exclude '**/*.integration.{test,spec}.ts' --coverage",
    "knip": "knip"
  },
  "dependencies": {
    "@beans-web/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "chokidar": "^6.0.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
