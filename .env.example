# Environment variables
# Copy this file to .env and fill in the values

# Comma-separated list of root folders to scan for beans projects (each
# subdirectory containing a .beans.yml, up to SCAN_DEPTH levels deep under
# each root, is treated as a project)
GIT_ROOT=/home/youruser/git

# Max recursion depth for project discovery under each GIT_ROOT entry
SCAN_DEPTH=4

# Server port
PORT=4780

# Bind address (loopback vs LAN)
HOST=127.0.0.1

# Path to the beans binary (defaults to "beans" resolved from PATH)
BEANS_BIN=beans

# Set to true only when a reverse proxy is the only way to reach this server.
# The cross-origin guard then reads X-Forwarded-Proto / X-Forwarded-Host to work
# out the public origin, which is what a TLS-terminating proxy needs. Leave it
# false for a directly exposed server: anything that can connect to the port
# could otherwise forge those headers.
TRUST_PROXY=false

# Comma-separated hostnames (no scheme, no port) the server accepts on
# incoming requests, in addition to the built-in localhost/127.0.0.1/[::1].
# Required the moment you reach the UI by any other hostname or LAN IP —
# without it those requests are rejected with 421. Leave unset for a
# loopback-only deployment.
ALLOWED_HOSTS=
