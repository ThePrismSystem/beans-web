# Environment variables
# Copy this file to .env and fill in the values

# Root folder to scan for beans projects
# GIT_ROOT=~/git

# Max recursion depth for project discovery
# SCAN_DEPTH=4

# Server port
# PORT=4780

# Bind address (loopback vs LAN)
# HOST=127.0.0.1

# Path to the beans binary (defaults to "beans" on PATH)
# BEANS_BIN=beans
